# ---------------------------------------------------------------------------
# SNAMI Bologna — configurazione
# ---------------------------------------------------------------------------
# Client ID dell'app OAuth headless creata nel dashboard Wix del sito
# (Impostazioni > Headless Settings > OAuth apps).
# Senza questo valore il sito parte lo stesso, ma blog, piani e area soci
# restano vuoti: vedi README, sezione "Collegare Wix".
NEXT_PUBLIC_WIX_CLIENT_ID=

# URL pubblico del sito, usato per i redirect di login e per i metadati SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome della collection CMS che ospita i documenti riservati ai soci.
WIX_DOCUMENTS_COLLECTION=DocumentiRiservati
